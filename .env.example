DJANGO_DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-value
REQUIRE_EMAIL_CONFIRMATION=False

# Email notifications and account activation
ORDER_NOTIFICATION_EMAIL=your-email@example.com
DEFAULT_FROM_EMAIL=your-email@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Sandbox M-Pesa
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-sandbox-consumer-key
MPESA_CONSUMER_SECRET=your-sandbox-consumer-secret
MPESA_PASSKEY=your-sandbox-passkey
MPESA_SHORT_CODE=174379
MPESA_CALLBACK_URL=https://your-public-https-domain.example.com/mpesa/callback/
